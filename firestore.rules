rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validProfile() {
        return request.resource.data.keys().hasAll(['name', 'email', 'createdAt'])
          && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.createdAt is timestamp;
      }
      allow read, delete: if owner();
      allow create: if owner() && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if owner() && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
      match /favorites/{movieId} {
        allow read, delete: if owner();
        allow create, update: if owner()
          && movieId.matches('([1-9]|1[0-4])')
          && request.resource.data.keys().hasOnly(['savedAt'])
          && request.resource.data.savedAt == request.time;
      }
      match /library/{movieId} {
        allow read, delete: if owner();
        allow create, update: if owner()
          && movieId.matches('([1-9]|1[0-4])')
          && request.resource.data.keys().hasAll(['favorite', 'status', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['favorite', 'status', 'updatedAt'])
          && request.resource.data.favorite is bool
          && request.resource.data.status in ['none', 'watchlist', 'watched']
          && request.resource.data.updatedAt == request.time;
      }
    }
  }
}
