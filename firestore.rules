rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/library/{movieId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && movieId.matches('([1-9]|1[0-9]|20)')
        && request.resource.data.keys().hasAll(['favorite', 'status', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['favorite', 'status', 'updatedAt'])
        && request.resource.data.favorite is bool
        && request.resource.data.status in ['none', 'watchlist', 'watched']
        && request.resource.data.updatedAt == request.time;
    }
  }
}
