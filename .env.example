# Firebase public client configuration. Supply values locally or in build settings.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional crash reporting. DSNs are public client configuration, not passwords.
EXPO_PUBLIC_SENTRY_DSN=

# Local-only integration tests. Enable only with an Expo development build.
EXPO_PUBLIC_USE_EMULATORS=0
