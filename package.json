{
  "name": "cinemastream",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "export:web": "expo export --platform web",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:catalog": "node scripts/check-catalog.cjs",
    "test:rules": "node --test tests/firestore.test.cjs",
    "format": "prettier --write app src assets/data scripts tests docs *.json *.md",
    "format:check": "prettier --check app src assets/data scripts tests docs *.json *.md"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-system-ui": "~58.0.6",
    "firebase": "^12.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5"
  },
  "private": true,
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "postcss": "^8.5.28",
    "@expo/cli": {
      "zod": "^4.6.6"
    }
  },
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  }
}
